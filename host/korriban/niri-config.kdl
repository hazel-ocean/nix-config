// Symlinked in (see ../home-niri.nix), not store-built, so edits hot-reload.
// Serves both backends: the DRM login session and the nested moonshine one.
// "Mod" follows the backend: Super on DRM, Alt when nested.

spawn-at-startup "noctalia"
spawn-at-startup "nu" "--no-config-file" "-c" "use /home/hazel/.config/nix-config/programs/nushell/overlays/system/korriban.nu *; brightness warm-cache"

xwayland-satellite {
    path "xwayland-satellite"
}

// Nested backend only; the DRM session uses HDMI-A-1 below.
output "winit" {
    scale 1.30
}

output "HDMI-A-1" {
    mode "3840x2160@120"
    scale 2
}

input {
    keyboard {
        numlock
    }
}

layout {
    gaps 16
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 5
        active-color "#c678dd"
        inactive-color "#6c7086"
    }
}

window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

// Steam's toast windows tile as full columns otherwise.
window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=0 y=0 relative-to="bottom-right"
    open-floating true
}

// HDMI-A-1 reports no VRR support; the rule is here for displays that do.
window-rule {
    match app-id=r#"^gamescope$"#
    open-fullscreen true
    variable-refresh-rate true
}

// The whole session is streamed over the LAN, so the vault is on the wire.
window-rule {
    match app-id=r#"^1Password$"#
    block-out-from "screen-capture"
}

prefer-no-csd

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+T hotkey-overlay-title="Open a Terminal: ghostty" { spawn "ghostty"; }
    Mod+D hotkey-overlay-title="Toggle Launcher: noctalia" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+N hotkey-overlay-title="Toggle Control Center: noctalia" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }

    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Shift+J        { focus-workspace-down; }
    Mod+Shift+K        { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Noctalia draws the OSD for these.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    Shift+XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up" "1"; }
    Shift+XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down" "1"; }
    XF86AudioMute allow-when-locked=true repeat=false { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true repeat=false { spawn "noctalia" "msg" "mic-mute"; }

    XF86AudioPlay allow-when-locked=true repeat=false { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioStop allow-when-locked=true repeat=false { spawn "noctalia" "msg" "media" "stop"; }
    XF86AudioNext allow-when-locked=true repeat=false { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPrev allow-when-locked=true repeat=false { spawn "noctalia" "msg" "media" "previous"; }

    // Backlight, DDC/CI or gamma, picked per press: see the korriban nushell overlay.
    XF86MonBrightnessUp allow-when-locked=true { spawn "nu" "--no-config-file" "-c" "use /home/hazel/.config/nix-config/programs/nushell/overlays/system/korriban.nu *; brightness up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "nu" "--no-config-file" "-c" "use /home/hazel/.config/nix-config/programs/nushell/overlays/system/korriban.nu *; brightness down"; }
    Shift+XF86MonBrightnessUp allow-when-locked=true { spawn "nu" "--no-config-file" "-c" "use /home/hazel/.config/nix-config/programs/nushell/overlays/system/korriban.nu *; brightness up 1"; }
    Shift+XF86MonBrightnessDown allow-when-locked=true { spawn "nu" "--no-config-file" "-c" "use /home/hazel/.config/nix-config/programs/nushell/overlays/system/korriban.nu *; brightness down 1"; }

    Mod+Shift+E { quit; }
}
