pane_frames false
copy_on_select true
show_startup_tips false

keybinds {
  unbind "Ctrl q"
  scroll {
    bind "c" { Clear; }
  }
  shared_except "locked" {
    bind "Ctrl y" {
      LaunchOrFocusPlugin "room" {
        floating true
        ignore_case true
        quick_jump true
      }
    }
  }
}

themes {
  // Verbatim catppuccin-latte (zellij built-in) with only frame_selected.base
  // recolored from green (64 160 43) to pink, for the active pane border.
  catppuccin-latte-custom {
    text_unselected {
      base 76 79 105
      background 220 224 232
      emphasis_0 254 100 11
      emphasis_1 4 165 229
      emphasis_2 64 160 43
      emphasis_3 210 15 57
