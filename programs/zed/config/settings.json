// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "buffer_font_weight": 400.0,
  "buffer_line_height": "comfortable",
  "helix_mode": true,
  "vim_mode": true,
  "disable_ai": false,
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Macchiato",
    "dark": "Catppuccin Macchiato"
  },
  "edit_predictions": {
    "mode": "subtle"
  },
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4"
    }
  },
  "language_models": {
    "ollama": {
      "api_url": "http://pigeon:11434",
      "available_models": [
        {
          "name": "qwen3:32b",
          "display_name": "Qwen3-32B",
          "max_tokens": 32768
        }
      ]
    }
  },
  "theme": {
    "mode": "system",
    "light": "kontras-light",
    "dark": "Tim's Experiments Dark"
  },
  "ui_font_size": 12.0,
  "buffer_font_family": "IntoneMono Nerd Font Propo",
  "buffer_font_size": 13.0,
  "soft_wrap": "editor_width",
  "terminal": {
    "dock": "right",
    "option_as_meta": true,
    "font_size": 12.0,
    "line_height": "standard"
  },
  // "vim_mode": true,
  // "vim": { "default_mode": "helix_normal" },
  "load_direnv": "shell_hook",
  "languages": {
    "Nix": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "nixfmt"
        }
      }
    },
    "Nu": {
      "tab_size": 2
    },
    "Ruby": {
      "language_servers": [
        "ruby-lsp",
        "rubocop",
        "!solargraph",
        "..."
      ]
    },
    // Enable herb and ruby-lsp for *.html.erb files
    "HTML+ERB": {
      "language_servers": [
        "herb",
        "ruby-lsp",
        "..."
      ]
    },
    // Enable ruby-lsp for *.js.erb files
    "JS+ERB": {
      "language_servers": [
        "ruby-lsp",
        "..."
      ]
    },
    // Enable ruby-lsp for *.yaml.erb files
    "YAML+ERB": {
      "language_servers": [
        "ruby-lsp",
        "..."
      ]
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "features": "all"
        }
      }
    }
  }
}