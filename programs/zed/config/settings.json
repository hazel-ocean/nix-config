// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "high",
        "model": "opus[1m]"
      },
      "type": "registry"
    }
  },
  "use_system_window_tabs": true,
  "enable_language_server": true,
  "ssh_connections": [
    {
      "host": "korriban.local",
      "username": "hazel",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/hazel/.config/nix-config"
          ]
        },
        {
          "paths": [
            "/home/hazel/Developer/moonshine-dev"
          ]
        }
      ]
    },
    {
      "host": "pigeon.local",
      "username": "hazel",
      "args": [],
      "projects": [
        {
          "paths": [
            "/Users/ocean/.config/nix-config"
          ]
        }
      ]
    }
  ],
  "when_closing_with_no_tabs": "platform_default",
  "format_on_save": "off",
  "tab_bar": {
    "show": true,
  },
  "ui_font_family": ".SystemUIFont",
  "ui_font_weight": 400.0,
  "tabs": {
    "show_close_button": "hover",
    "show_diagnostics": "off",
    "close_position": "left",
    "git_status": true,
    "file_icons": false,
  },
  "title_bar": {
    "show_menus": false,
  },
  "file_finder": {
    "modal_max_width": "small",
  },
  "search": {
    "center_on_match": false,
  },
  "buffer_font_weight": 400.0,
  "buffer_line_height": {
    "custom": 1.6,
  },
  "buffer_font_features": {
    "cv02": true,
    "cv03": true,
    "cv05": true,
    "cv38": true,
    "cv61": true,
    "cv62": true,
    "cv66": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss07": true,
    "ss08": true,
    "ss09": true,
    "ss10": true,
    "ss11": true,
    "zero": true,
    "calt": true,
  },
  "helix_mode": true,
  "disable_ai": false,
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },
  "edit_predictions": {
    "mode": "subtle",
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "mcp:things:get_headings": {
          "default": "allow"
        },
        "mcp:obsidian:list_directory": {
          "default": "allow",
        },
        "fetch": {
          "default": "allow",
        },
        "mcp:things:get_todos": {
          "default": "allow",
        },
        "mcp:obsidian:read_note": {
          "default": "allow",
        },
        "mcp:asana:asana_get_task": {
          "default": "allow",
        },
      },
    },
    "favorite_models": [
      {
        "provider": "anthropic",
        "model": "claude-opus-4-8",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "play_sound_when_agent_done": "when_hidden",
    "inline_assistant_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6-thinking-latest",
    },
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-opus-4-8",
    },
  },
  "context_servers": {
    "things": {
      "command": "/etc/profiles/per-user/hazel/bin/mcp-things",
      "args": [],
    },
    "obsidian": {
      "command": "/etc/profiles/per-user/hazel/bin/mcp-obsidian",
      "args": [
        "/Users/hazel/Library/Mobile Documents/com~apple~CloudDocs/Obsidian/OneSignal/",
      ],
    },
    "asana": {
      "enabled": true,
      "command": "/bin/sh",
      "args": [
        "-c",
        "export ASANA_ACCESS_TOKEN=$(cat ~/.config/mcp-asana/access-token) && exec /etc/profiles/per-user/hazel/bin/mcp-asana",
      ],
    },
  },
  "language_models": {
    "ollama": {
      "api_url": "http://pigeon:11434",
      "available_models": [
        {
          "name": "qwen3:32b",
          "display_name": "Qwen3-32B",
          "max_tokens": 32768,
        },
      ],
    },
  },
  "theme": {
    "mode": "system",
    "light": "kontras-light",
    "dark": "Catppuccin Mocha"
  },
  "ui_font_size": 14.0,
  "buffer_font_family": "Maple Mono NF",
  "buffer_font_size": 13.0,
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic",
      },
    },
  },
  "soft_wrap": "editor_width",
  "terminal": {
    "font_weight": 350.0,
    "dock": "bottom",
    "option_as_meta": true,
    // "font_size": 13.0,
  },
  "load_direnv": "shell_hook",
  "prettier": {
    "allowed": false,
  },
  "languages": {
    "TypeScript": {
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "TSX": {
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "JavaScript": {
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "Nix": {
      // "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "nixfmt",
        },
      },
    },
    "Nu": {
      "tab_size": 2,
    },
    "Ruby": {
      "language_servers": [
        "ruby-lsp",
        "rubocop",
        "!solargraph",
        "..."
      ],
    },
    // Enable herb and ruby-lsp for *.html.erb files
    "HTML+ERB": {
      "language_servers": [
        "herb",
        "ruby-lsp",
        "..."
      ],
    },
    // Enable ruby-lsp for *.js.erb files
    "JS+ERB": {
      "language_servers": [
        "ruby-lsp",
        "..."
      ],
    },
    // Enable ruby-lsp for *.yaml.erb files
    "YAML+ERB": {
      "language_servers": [
        "ruby-lsp",
        "..."
      ],
    },
  },
  "inlay_hints": {
    "enabled": true,
    "show_parameter_hints": true,
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true
          },
          "closureReturnTypeHints": {
            "enable": "always"
          }
        },
        "cargo": {
          "features": "all",
        },
      },
    },
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
    "dockerfile": true,
    "dracula": true,
    "fleet-themes": true,
    "github-theme": true,
    "html": true,
    "just": true,
    "just-ls": true,
    "nix": true,
    "nu": true,
    "proto": true,
    "rose-pine-theme": true,
    "ruby": true,
    "snazzy": true,
    "sql": true,
    "toml": true,
  },
}
